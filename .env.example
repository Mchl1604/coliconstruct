APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Uploads
#
# Everything a person uploads - profile pictures, project documents,
# completion photographs, task and report images - goes on one private disk.
# Nothing is served by the web server; every read goes through a route that
# checks who is asking. See app/Http/Controllers/UploadedFileController.php.
#
# Left as `local` the files are a directory under storage/, which is right for
# development. A deployed container's disk is emptied by every deploy, so a
# deployment must set `s3` and point it at object storage - Cloudflare R2,
# Amazon S3, or anything else speaking the same protocol.
#
#   UPLOADS_DRIVER=s3
#   UPLOADS_KEY=...
#   UPLOADS_SECRET=...
#   UPLOADS_BUCKET=coliconstruct-uploads
#   UPLOADS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# The bucket must NOT be public. Nothing reads it except this application.
# ---------------------------------------------------------------------------
UPLOADS_DRIVER=local
UPLOADS_KEY=
UPLOADS_SECRET=
UPLOADS_REGION=auto
UPLOADS_BUCKET=
UPLOADS_ENDPOINT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1


# ---------------------------------------------------------------------------
# Email
#
# Leave MAIL_MAILER=log and nothing is delivered: messages are written to
# storage/logs/laravel.log instead, and the interface stops promising that
# anybody was emailed. Set it to `smtp` and fill in the five values below to
# switch real delivery on. See EMAIL_SETUP.md for provider-by-provider values.
#
# On a host that blocks outbound SMTP - Railway does so on every plan below
# Pro - set MAIL_MAILER=resend instead and give RESEND_API_KEY below. Resend
# goes out over HTTPS, so no mail port has to be open. The rest of the MAIL_*
# values still apply; the SMTP-only ones are simply ignored.
#
# Verify the settings with:  php artisan mail:test you@example.com
# ---------------------------------------------------------------------------
MAIL_MAILER=log
# Encryption. Leave null for port 587 (STARTTLS, the usual choice); set it to
# `smtps` for an implicit-TLS port such as 465.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# Where the public Contact page sends enquiries. Defaults to MAIL_FROM_ADDRESS.
MAIL_INQUIRIES_TO="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Only read when MAIL_MAILER=resend. Create the key at resend.com/api-keys.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Company branding
#
# What every system email is dressed in: the logo and name in the header, the
# contact details in the footer. Anything left empty is simply omitted.
#
# COMPANY_LOGO is resolved against APP_URL unless it is already an absolute
# URL, so it must point at a file an inbox can fetch without signing in.
# ---------------------------------------------------------------------------
COMPANY_NAME="ColiConstruct"
COMPANY_TAGLINE="Project Management System"
COMPANY_LOGO="img/coliconstructlogor.png"
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE="${APP_URL}"
COMPANY_COLOR_PRIMARY="#0d6efd"
COMPANY_COLOR_HEADER="#0b2545"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
